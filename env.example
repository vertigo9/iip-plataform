IIP_ENVIRONMENT=development
IIP_DEBUG=false
IIP_LOG_LEVEL=INFO
IIP_LOG_FORMAT=json

# Obsidian vault
# Windows example: IIP_OBSIDIAN_VAULT=C:\IIP\knowledge-vault
IIP_OBSIDIAN_VAULT=./vault

# Credenciais de providers de dados (opcionais — sem elas, os providers
# que precisam de credencial ficam PARTIAL e o ProviderFactory retorna
# None em vez de instanciar; comandos como `iip fetch-template` avisam
# e seguem sem esses campos, não travam).
# bolsai: conta gratuita em https://usebolsai.com — cotação/fundamentos
# de ações e FIIs.
IIP_BOLSAI_API_KEY=
# Cache opcional em disco das respostas do bolsai. O plano gratuito permite 200
# chamadas por dia (as rejeitadas com 429 TAMBÉM contam) e reinicia à meia-noite
# UTC; um lote completo mais algumas reexecuções esgotam isso. Só liga se AS
# DUAS variáveis estiverem preenchidas; uma resposta só é reaproveitada enquanto
# for mais nova que o TTL, então nenhum preço fica mais velho que ele. Guarda só
# respostas 200 válidas, por URL (a chave da API nunca é gravada).
# IIP_BOLSAI_CACHE_DIR=data/cache/bolsai
# IIP_BOLSAI_CACHE_TTL_MINUTES=60
# brapi.dev: conta gratuita em https://brapi.dev/dashboard — cotação de
# ações, FIIs e BDRs (cobre BDR, que o bolsai não cobre).
IIP_BRAPI_TOKEN=
