# Python/cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Runtime/output data
*.log
.logs/
*.tmp
*.temp

# Generated reports and local data
reports/
data/*
!data/.gitkeep

# Local environments and editors
.venv/
venv/
.env
.env.*
!.env.example
.vscode/
.idea/

# Backups and historical snapshots
*.bak
*backup*
*BROKEN*
*.orig
*.rej
*.pre_sync_fix
*.pre-fix

# Vault Obsidian real e demos -- dado pessoal/de teste, nunca deve ir
# pro Git. Achado em 12/09/2026: "vault/" nunca esteve aqui (so
# "demo_vault/" existia, e corrompido -- salvo em UTF-16 misturado com
# UTF-8, virando bytes nulos que o git nunca reconheceu como padrao
# valido). 70 arquivos do vault real ja tinham sido commitados por
# causa dessa lacuna.
vault/
demo_vault/

# Snapshots e logs gerados pela automacao diaria (iip refresh-portfolio,
# executar_atualizacao_diaria.ps1) -- dado do dia a dia, nao codigo.
portfolio_snapshots/
logs_atualizacao/

# OS files
.DS_Store
Thumbs.db

# Large installers and archives
*.exe
*.zip

src/iip_platform.egg-info/
hglg11.json
ivvb11.json
itsa4.json
craa11.json
